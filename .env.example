# Optional: NVIDIA NIM for patient-mode extraction and trial summaries.
# https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Chat model is fixed to moonshotai/kimi-k3.

# IndexNow key for Bing, DuckDuckGo, and other engines that read that index.
# 8-128 letters or digits. The site serves it at /{KEY}.txt. Leave blank to skip.
INDEXNOW_KEY=

# Sent by Vercel Cron as Authorization: Bearer $CRON_SECRET. Required in production.
CRON_SECRET=
